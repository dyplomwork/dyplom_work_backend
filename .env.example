# ── Backend environment variables ──────────────────────────────────────────
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# docker-compose.yml reads these; production (Railway) sets them in its dashboard.

# PostgreSQL credentials
POSTGRES_USER=casino_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=casino_db

# Secret used to sign/verify JWTs. MUST be identical in auth-service and
# games-service. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_secret

# Google OAuth client ID (required for "Sign in with Google").
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Initial admin account. The admin is seeded ONLY when SEED_DEFAULT_ADMIN=true
# AND ADMIN_PASSWORD is set. Disable (false) in production after first setup.
SEED_DEFAULT_ADMIN=true
ADMIN_PASSWORD=change_me
